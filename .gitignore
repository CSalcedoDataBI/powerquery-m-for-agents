# OS / editor cruft
Thumbs.db
.DS_Store
*.swp
.vscode/
.idea/

# Session / temp working files
_tmp_*
*.bak
*.tmp

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# agentic-board: session state is local; config.json is the repo's standing answers (a team
# decision, versioned like roles.json)
.agentic-board/*
!.agentic-board/config.json

# Scratch left behind by a crashed sync. The prefix moved from .library.staging- to
# .publish-; an ignore rule guarding a path the code no longer uses guards nothing.
skills/m-reference/.publish-*/
/HANDOFF.md
/.handoffs/

# Session scratch: one-off scripts, unoptimised captures.
/tmp/

# Agent harness notes. They record what is true of the MACHINE a session ran on —
# assembly paths, which refresh path leaves a banner — not of this repository.
/.claude/

# Throwaway PBIP and results of lab/runner/run_examples.py; rebuilt on every run.
/lab/runner/build/

# Prompts, raw answers and measurements of lab/drafting/ runs. Pages that pass review are
# copied into skills/ by pilot.py collect; nothing else leaves this folder.
/lab/drafting/out/

# Private working material, kept in the private repo CSalcedoDataBI/Power-Query-Scripts
# (folder powerquery-m-for-agents/): the #shared exports and the review PBIPs. The scripts
# read and write them here as before; the plugin directory does not validate export-ignore.
exports/*.json
lab/review/*/
!lab/review/thank-you/
