model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["ListNumerics", "List.Covariance (1)", "List.Product (1)"]

queryGroup 'List.Covariance'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'List.Product'

	annotation PBI_QueryGroupOrder = 1

ref table ListNumerics
