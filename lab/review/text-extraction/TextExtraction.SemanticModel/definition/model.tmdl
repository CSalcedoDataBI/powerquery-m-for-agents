model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["TextExtraction", "Text.At (1)", "Text.End (1)", "Text.Middle (1)", "Text.Range (1)", "Text.Start (1)"]

queryGroup 'Text.At'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Text.End'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Text.Middle'

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Text.Range'

	annotation PBI_QueryGroupOrder = 3

queryGroup 'Text.Start'

	annotation PBI_QueryGroupOrder = 4

ref table TextExtraction
