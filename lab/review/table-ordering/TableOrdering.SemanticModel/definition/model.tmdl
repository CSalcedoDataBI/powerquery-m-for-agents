model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["TableOrdering", "Table.AddRankColumn (1)", "Table.Max (1)", "Table.MaxN (1)", "Table.Min (1)", "Table.MinN (1)", "Table.Sort (1)"]

queryGroup 'Table.AddRankColumn'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Table.Max'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Table.MaxN'

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Table.Min'

	annotation PBI_QueryGroupOrder = 3

queryGroup 'Table.MinN'

	annotation PBI_QueryGroupOrder = 4

queryGroup 'Table.Sort'

	annotation PBI_QueryGroupOrder = 5

ref table TableOrdering
