		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["RecordSelection", "Record.Field (1)", "Record.Field (2)", "Record.Field (3)", "Record.FieldNames (1)", "Record.FieldNames (2)", "Record.FieldNames (3)", "Record.FieldOrDefault (1)", "Record.FieldOrDefault (2)", "Record.FieldOrDefault (3)", "Record.FieldValues (1)", "Record.FieldValues (2)", "Record.FieldValues (3)", "Record.SelectFields (1)", "Record.SelectFields (2)", "Record.SelectFields (3)"]

queryGroup 'Record.Field'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Record.FieldNames'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Record.FieldOrDefault'

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Record.FieldValues'

	annotation PBI_QueryGroupOrder = 3

queryGroup 'Record.SelectFields'

	annotation PBI_QueryGroupOrder = 4

ref table RecordSelection
