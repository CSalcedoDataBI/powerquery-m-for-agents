model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["ListSetOperations", "List.Difference (1)", "List.Intersect (1)", "List.Union (1)"]

queryGroup 'List.Difference'

