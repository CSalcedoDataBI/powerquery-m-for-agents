expression 'BinaryFormat.Choice (1)' =
		let
		    data = #binary({3, 10, 20, 30}),
		    reader = BinaryFormat.Choice(
		        BinaryFormat.Byte,
		        (count) => BinaryFormat.List(BinaryFormat.Byte, count)
		    )
		in
		    reader(data)
	lineageTag: 11232bfe-9eac-5781-95a7-d185ea4d9411
	queryGroup: 'BinaryFormat.Choice'

expression 'BinaryFormat.Choice (2)' =
		let
		    data = #binary({3, 10, 20, 30}),
		    reader = BinaryFormat.Choice(
		        BinaryFormat.Byte,
		        (count) => BinaryFormat.List(BinaryFormat.Byte, count),
		        type list,
		        (count, values) => [count = count, values = values]
		    )
		in
		    reader(data)
	lineageTag: 545f6b48-0588-56ee-a665-4e8b66f35550
	queryGroup: 'BinaryFormat.Choice'

expression 'BinaryFormat.Choice (3)' =
		let
		    data = #binary({0}),
		    reader = BinaryFormat.Choice(
		        BinaryFormat.Byte,
		        (count) => if count = 0 then BinaryFormat.Null else BinaryFormat.List(BinaryFormat.Byte, count),
		        null,
		        (count, value) => [count = count, value = value]
		    )
		in
		    reader(data)
	lineageTag: f8cdb3f7-47e8-5ae5-9c65-64450ff1b36e
	queryGroup: 'BinaryFormat.Choice'

expression 'BinaryFormat.Null (1)' =
		{BinaryFormat.Null(Binary.FromList({})), BinaryFormat.Null(Binary.FromList({1, 2, 3}))}
	lineageTag: 0ca680d5-9e48-5c75-aded-237504ca7f68
	queryGroup: 'BinaryFormat.Null'

expression 'BinaryFormat.Null (2)' =
