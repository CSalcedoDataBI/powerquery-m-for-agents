model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["TableOther", "Table.Buffer (1)", "Table.StopFolding (1)"]

queryGroup 'Table.Buffer'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Table.StopFolding'

	annotation PBI_QueryGroupOrder = 1

ref table TableOther
