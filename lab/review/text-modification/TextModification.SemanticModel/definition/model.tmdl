model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["TextModification", "Text.Insert (1)", "Text.Remove (1)", "Text.RemoveRange (1)", "Text.Replace (1)", "Text.ReplaceRange (1)", "Text.Select (1)"]

queryGroup 'Text.Insert'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Text.Remove'

	annotation PBI_QueryGroupOrder = 1

queryGroup 'Text.RemoveRange'

	annotation PBI_QueryGroupOrder = 2

queryGroup 'Text.Replace'

	annotation PBI_QueryGroupOrder = 3

queryGroup 'Text.ReplaceRange'

	annotation PBI_QueryGroupOrder = 4

queryGroup 'Text.Select'

	annotation PBI_QueryGroupOrder = 5

ref table TextModification
