model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["ValuesImplementation", "Table.WithErrorContext (1)"]

queryGroup 'Table.WithErrorContext'

	annotation PBI_QueryGroupOrder = 0

ref table ValuesImplementation
