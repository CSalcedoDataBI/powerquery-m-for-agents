, "Text.Type", "Text.Upper", "TextEncoding.Ascii", "TextEncoding.BigEndianUnicode", "TextEncoding.Type", "TextEncoding.Unicode", "TextEncoding.Utf16", "TextEncoding.Utf8", "TextEncoding.Windows", "Time.EndOfHour", "Time.From", "Time.FromText", "Time.Hour", "Time.Minute", "Time.Second", "Time.StartOfHour", "Time.ToRecord", "Time.ToText", "Time.Type", "TraceLevel.Critical", "TraceLevel.Error", "TraceLevel.Information", "TraceLevel.Type", "TraceLevel.Verbose", "TraceLevel.Warning", "Type.AddTableKey", "Type.ClosedRecord", "Type.Facets", "Type.ForFunction", "Type.ForRecord", "Type.FunctionParameters", "Type.FunctionRequiredParameters", "Type.FunctionReturn", "Type.Is", "Type.IsNullable", "Type.IsOpenRecord", "Type.ListItem", "Type.NonNullable", "Type.OpenRecord", "Type.RecordFields", "Type.ReplaceFacets", "Type.ReplaceTableKeys", "Type.ReplaceTablePartitionKey", "Type.TableColumn", "Type.TableKeys", "Type.TablePartitionKey", "Type.TableRow", "Type.TableSchema", "Type.Type", "Type.Union", "Uri.BuildQueryString", "Uri.Combine", "Uri.EscapeDataString", "Uri.Parts", "Uri.Type", "Value.Add", "Value.As", "Value.Compare", "Value.Divide", "Value.Equals", "Value.Expression", "Value.FromText", "Value.Is", "Value.Metadata", "Value.Multiply", "Value.NullableEquals", "Value.RemoveMetadata", "Value.ReplaceMetadata", "Value.ReplaceType", "Value.Subtract", "Value.Type", "WebMethod.Delete", "WebMethod.Get", "WebMethod.Head", "WebMethod.Patch", "WebMethod.Post", "WebMethod.Put", "WebMethod.Type", "Xml.Document", "Xml.Tables"},
				            Environment = Record.SelectFields(#shared, Allowed, MissingField.Ignore),
				            // A text as an M text literal: "#(" first, so the escapes added after it stay single.
				            // Every other control character as #(XXXX): written raw, it does not survive the trip
				            // back through ADOMD (U+0001 in Binary.InferContentType's delimiters was lost).
				            Controls = List.Numbers(0, 32) & List.Numbers(127, 33) & {8232, 8233},
				            Quote = (t as text) as text =>
				                let
				                    s1 = Text.Replace(t, "#(#)(", "#(#)(#)("),
				                    s2 = Text.Replace(s1, """", """"""),
				                    s3 = Text.Replace(s2, "#(cr)", "#(#)(cr)"),
				                    s4 = Text.Replace(s3, "#(lf)", "#(#)(lf)"),
				                    s5 = Text.Replace(s4, "#(tab)", "#(#)(tab)"),
				                    s6 = if Text.Length(Text.Select(s5, List.Transform(Controls, Character.FromNumber))) = 0 then s5
				                        else Text.Combine(List.Transform(Text.ToList(s5), (c) =>
				                            if List.Contains(Controls, Character.ToNumber(c))
				                            then "#(#)(" & Text.PadStart(Number.ToText(Character.ToNumber(c), "X", "en-US"), 4, "0") & ")"
				                            else c))
				                in
				                    """" & s6 & """",
				            Keywords = {"and", "as", "each", "else", "error", "false", "if", "in", "is", "let", "meta",
				                "not", "null", "or", "otherwise", "section", "shared", "then", "true", "try", "type"},
				            IdentChars = {"A".."Z", "a".."z", "0".."9", "_"},
				            Ident = (name as text) as text =>
				                if name <> "" and Text.Select(name, IdentChars) = name
				                    and not List.Contains({"0".."9"}, Text.Start(name, 1))
				                    and not List.Contains(Keywords, name)
				                then name
				                else "#" & Quote(name),
				            Num = (n as number) as text =>
				                if Number.IsNaN(n) then "#nan"
				                else if n = Number.PositiveInfinity then "#infinity"
				                else if n = Number.NegativeInfinity then "-#infinity"
				                else try Number.ToText(n, "R", "en-US") otherwise Number.ToText(n, null, "en-US"),
				            // Int64.Type, Currency.Type and friends are `number` with no facets set: what names them
				            // is Documentation.Name in their metadata. Printed only when #shared has that name, so a
				            // result can never show a type name the library does not export.
				            TypeName = (t as type) as nullable text =>
				                let
				                    n = Record.FieldOrDefault(Value.Metadata(t), "Documentation.Name", null)
				                in
				                    if n is text and Text.EndsWith(n, ".Type") and Record.HasFields(#shared, n)
				                    then n else null,
				            Primitive = (t as type) as text =>
				                let
				                    candidates = {
				                        {type logical, "logical"}, {type number, "number"}, {type time, "time"},
				                        {type date, "date"}, {type datetime, "datetime"},
				                        {type datetimezone, "datetimezone"}, {type duration, "duration"},
				                        {type text, "text"}, {type binary, "binary"}, {type type, "type"},
				                        {type list, "list"}, {type record, "record"}, {type table, "table"},
				                        {type function, "function"}, {type anynonnull, "any"}
				                    },
				                    hit = List.First(List.Select(candidates, each Type.Is(t, _{0})), null)
				                in
				                    if Type.Is(t, type none) then "none" else if hit = null then "any" else hit{1},
				            FieldsText = (fields as record, open as logical) as text =>
				                let
				                    names = Record.FieldNames(fields),
				                    parts = List.Transform(names, (n) =>
				                        let f = Record.Field(fields, n) in
				                            (if f[Optional] then "optional " else "") & Ident(n) & " = " & TypeText(f[Type])),
				                    all = if open then parts & {"..."} else parts
				                in
				                    "[" & Text.Combine(all, ", ") & "]",
				            FunctionTypeText = (t as type) as text =>
				                let
				                    params = Type.FunctionParameters(t),
				                    names = Record.FieldNames(params),
				                    required = Type.FunctionRequiredParameters(t),
				                    parts = List.Transform(List.Positions(names), (i) =>
				                        (if i >= required then "optional " else "") & Ident(names{i}) & " as "
				                            & TypeText(Record.Field(params, names{i})))
				                in
				                    "function (" & Text.Combine(parts, ", ") & ") as " & TypeText(Type.FunctionReturn(t)),
				            TypeText = (t as type) as text =>
				                let
				                    nullable = Type.IsNullable(t) and not Type.Is(t, type null),
				                    base = Type.NonNullable(t),
				                    named = TypeName(t),
				                    body =
				                        if Type.Is(t, type null) then "null"
				                        else if named <> null then named
				                        else if Type.Is(base, type table) then
				                            "table " & FieldsText(Type.RecordFields(Type.TableRow(base)), false)
				                        else if Type.Is(base, type record) then
				                            FieldsText(Type.RecordFields(base), Type.IsOpenRecord(base))
				                        // A let binding that calls itself needs @; without it the engine reports
				                        // "The import TypeText matches no exports".
				                        else if Type.Is(base, type list) then "{" & @TypeText(Type.ListItem(base)) & "}"
				                        else if Type.Is(base, type function) then FunctionTypeText(base)
				                        else Primitive(base),
				                    // `any` includes null; the same type without null is spelled anynonnull.
				                    spelled = if body = "any" and not Type.IsNullable(t) then "anynonnull" else body
				                in
				                    (if nullable and body <> "any" then "nullable " else "") & spelled,
				            ErrorText = (e as record) as text =>
				                let
				                    detail = Record.FieldOrDefault(e, "Detail", null),
				                    detailText = if detail = null then "" else " | Detail: " & Safe(() => detail)
				                in
				                    "error: " & OrEmpty(e[Reason]) & ": " & OrEmpty(e[Message]) & detailText,
				            OrEmpty = (x as any) as text => if x is null then "" else Text.From(x),
				            // Every nested value is rendered through Safe with a thunk, so an error in one cell shows
				            // as that cell's text instead of failing the whole case.
				            Safe = (get as function) as text =>
				                let r = try Render(get()) in if r[HasError] then ErrorText(r[Error]) else r[Value],
				            MaxItems = 100,
				            ListText = (items as list) as text =>
				                let
				                    head = List.FirstN(items, MaxItems + 1),
				                    shown = List.FirstN(head, MaxItems),
				                    parts = List.Transform(List.Positions(shown), (i) => Safe(() => shown{i})),
				                    more = if List.Count(head) > MaxItems then {"..."} else {}
				                in
				                    "{" & Text.Combine(parts & more, ", ") & "}",
				            TableText = (t as table) as text =>
				                let
				                    head = Table.FirstN(t, MaxItems + 1),
				                    shown = Table.FirstN(head, MaxItems),
				                    columns = Table.ColumnNames(t),
				                    rows = List.Transform(Table.ToRecords(shown), (r) =>
				                        "{" & Text.Combine(List.Transform(columns, (c) => Safe(() => Record.Field(r, c))), ", ")
				                            & "}"),
				                    more = if Table.RowCount(head) > MaxItems then {"..."} else {}
				                in
				                    "#table(type " & TypeText(Value.Type(t)) & ", {" & Text.Combine(rows & more, ", ") & "})",
				            Render = (v as any) as text =>
				                if v is null then "null"
				                else if v is logical then (if v then "true" else "false")
				                else if v is number then Num(v)
				                else if v is text then Quote(v)
				                else if v is date then
				                    "#date(" & Text.Combine(List.Transform({Date.Year(v), Date.Month(v), Date.Day(v)}, Num), ", ") & ")"
				                else if v is datetimezone then
				                    "#datetimezone(" & Text.Combine(List.Transform({Date.Year(v), Date.Month(v), Date.Day(v),
				                        Time.Hour(v), Time.Minute(v), Time.Second(v),
				                        DateTimeZone.ZoneHours(v), DateTimeZone.ZoneMinutes(v)}, Num), ", ") & ")"
				                else if v is datetime then
				                    "#datetime(" & Text.Combine(List.Transform({Date.Year(v), Date.Month(v), Date.Day(v),
				                        Time.Hour(v), Time.Minute(v), Time.Second(v)}, Num), ", ") & ")"
				                else if v is time then
				                    "#time(" & Text.Combine(List.Transform({Time.Hour(v), Time.Minute(v), Time.Second(v)}, Num), ", ") & ")"
				                else if v is duration then
				                    "#duration(" & Text.Combine(List.Transform({Duration.Days(v), Duration.Hours(v),
				                        Duration.Minutes(v), Duration.Seconds(v)}, Num), ", ") & ")"
				                else if v is binary then
				                    "#binary({" & Text.Combine(List.Transform(Binary.ToList(v), Num), ", ") & "})"
				                else if v is list then ListText(v)
				                else if v is record then
				                    "[" & Text.Combine(List.Transform(Record.FieldNames(v), (f) =>
				                        Ident(f) & " = " & Safe(() => Record.Field(v, f))), ", ") & "]"
				                else if v is table then TableText(v)
				                else if v is type then "type " & TypeText(v)
				                else if v is function then FunctionTypeText(Value.Type(v))
				                else "<" & Primitive(Value.Type(v)) & ">",
				            // Separate Expression.Evaluate calls share cached values: with the same #table literal in
				            // two cases, Table.TransformColumnNames in one made Table.Buffer in the other return the
				            // renamed columns (reproduced 2026-09-29; one query with both steps is not affected). A
				            // distinct environment per case is meant to keep each evaluation to itself.
				            Run = (i as number, code as text) as text =>
				                let r = try Render(Expression.Evaluate(code, Environment & [#"__runner case" = i])) in
				                    if r[HasError] then ErrorText(r[Error]) else r[Value],
				            Result = #table(
				                type table [seq = Int64.Type, id = text, result = text],
				                List.Transform(List.Positions(Cases), (i) => {i, Cases{i}{0}, Run(i, Cases{i}{1})})
				            )
				        in
				            Result,
				    Pages = #table(type table [seq = Int64.Type, Function = text, Description = text, Block = Int64.Type, Code = text, Recorded = text], {{0, "Table.AddColumn", "Adds a column named newColumnName to the table table. The values for the column are computed using the specified selection function columnGenerator with each row taken as an input.", 1, "let#(lf)    T = #table(type table [Name = text, Qty = Int64.Type], {{""a"", 1}, {""b"", 2}, {""a"", 3}})#(lf)in#(lf)    {Value.Type(Table.AddColumn(T, ""D"", each [Qty] * 2, Int64.Type)), Value.Type(Table.AddColumn(T, ""D"", each [Qty] * 2))}", "{type table [Name = text, Qty = Int64.Type, D = Int64.Type], type table [Name = text, Qty = Int64.Type, D = any]}"}, {1, "Table.AddFuzzyClusterColumn", "Adds a new column newColumnName to table with representative values of columnName. The representatives are obtained by fuzzily matching values in columnName, for each row. An optional set of options may be included to specify how to compare the key columns. Options include: - Culture : Allows grouping records based on culture-specific rules. It can be any valid culture name. For example, a Culture option of ""ja-JP"" groups records based on the Japanese culture. The default value is """", which groups based on the Invariant English culture. - IgnoreCase : A logical (true/false) value that allows case-insensitive key grouping. For example, when true, ""Grapes"" is grouped with ""grapes"". The default value is true. - IgnoreSpace : A logical (true/false) value that allows combining of text parts in order to find groups. For example, when true, ""Gra pes"" is grouped with ""Grapes"". The default value is true. - SimilarityColumnName : A name for the column that shows the similarity between an input value and the representative value for that input. The default value is null, in which case a new column for similarities will not be added. - Threshold : A number between 0.00 and 1.00 that specifies the similarity score at which two values will be grouped. For example, ""Grapes"" and ""Graes"" (missing the ""p"") are grouped together only if this option is set to less than 0.90. A threshold of 1.00 only allows exact matches. (Note that a fuzzy ""exact match"" might ignore differences like casing, word order, and punctuation.) The default value is 0.80. - TransformationTable : A table that allows grouping records based on custom value mappings. It should contain ""From"" and ""To"" columns. For example, ""Grapes"" is grouped with ""Raisins"" if a transformation table is provided with the ""From"" column containing ""Grapes"" and the ""To"" column containing ""Raisins"". Note that the transformation will be applied to all occurrences of the text in the transformation table. With the above transformation table, ""Grapes are sweet"" will also be grouped with ""Raisins are sweet"".", 1, "Table.AddFuzzyClusterColumn(#table({""City""}, {{""Seattle""}, {""seattle""}}), ""City"", ""Cluster"")", "error: Expression.Error: We only support text columns for fuzzy join operations. The column 'City' is not of type text."}, {2, "Table.AddFuzzyClusterColumn", "Adds a new column newColumnName to table with representative values of columnName. The representatives are obtained by fuzzily matching values in columnName, for each row. An optional set of options may be included to specify how to compare the key columns. Options include: - Culture : Allows grouping records based on culture-specific rules. It can be any valid culture name. For example, a Culture option of ""ja-JP"" groups records based on the Japanese culture. The default value is """", which groups based on the Invariant English culture. - IgnoreCase : A logical (true/false) value that allows case-insensitive key grouping. For example, when true, ""Grapes"" is grouped with ""grapes"". The default value is true. - IgnoreSpace : A logical (true/false) value that allows combining of text parts in order to find groups. For example, when true, ""Gra pes"" is grouped with ""Grapes"". The default value is true. - SimilarityColumnName : A name for the column that shows the similarity between an input value and the representative value for that input. The default value is null, in which case a new column for similarities will not be added. - Threshold : A number between 0.00 and 1.00 that specifies the similarity score at which two values will be grouped. For example, ""Grapes"" and ""Graes"" (missing the ""p"") are grouped together only if this option is set to less than 0.90. A threshold of 1.00 only allows exact matches. (Note that a fuzzy ""exact match"" might ignore differences like casing, word order, and punctuation.) The default value is 0.80. - TransformationTable : A table that allows grouping records based on custom value mappings. It should contain ""From"" and ""To"" columns. For example, ""Grapes"" is grouped with ""Raisins"" if a transformation table is provided with the ""From"" column containing ""Grapes"" and the ""To"" column containing ""Raisins"". Note that the transformation will be applied to all occurrences of the text in the transformation table. With the above transformation table, ""Grapes are sweet"" will also be grouped with ""Raisins are sweet"".", 2, "Table.AddFuzzyClusterColumn(#table(type table [City = text], {{""Seattle""}, {""seattle""}, {""Seatle""}, {""Redmond""}}), ""City"", ""Cluster"")", "#table(type table [City = text, Cluster = text], {{""Seattle"", ""Seattle""}, {""seattle"", ""Seattle""}, {""Seatle"", ""Seattle""}, {""Redmond"", ""Redmond""}})"}, {3, "Table.AddIndexColumn", "Appends a column named newColumnName to the table with explicit position values. An optional value, initialValue, the initial index value. An optional value, increment, specifies how much to increment each index value.", 1, "let#(lf)    T = #table(type table [Name = text, Qty = Int64.Type], {{""a"", 1}, {""b"", 2}, {""a"", 3}})#(lf)in#(lf)    Table.AddIndexColumn(T, ""Index"", 1, 1, Int64.Type)", "#table(type table [Name = text, Qty = Int64.Type, Index = Int64.Type], {{""a"", 1, 1}, {""b"", 2, 2}, {""a"", 3, 3}})"}, {4, "Table.AddJoinColumn", "Joins the rows of table1 with the rows of table2 based on the equality of the values of the key columns selected by key1 (for table1) and key2 (for table2). The results are stored in a column named newColumnName. This function behaves identically to Table.NestedJoin with joinKind set to JoinKind.LeftOuter.", 1, "Table.AddJoinColumn(#table({""Id""}, {{1}, {2}}), ""Id"", #table({""Id"", ""V""}, {{1, ""x""}}), ""Id"", ""Match"")", "#table(type table [Id = any, Match = table [Id = any, V = any]], {{1, #table(type table [Id = any, V = any], {{1, ""x""}})}, {2, #table(type table [Id = any, V = any], {})}})"}, {5, "Table.AddKey", "Adds a key to table, where columns is the list of column names that define the key, and isPrimary specifies whether the key is primary.", 1, "let#(lf)    T = #table(type table [Name = text, Qty = Int64.Type], {{""a"", 1}, {""b"", 2}, {""a"", 3}})#(lf)in#(lf)    Table.Keys(Table.AddKey(T, {""Name""}, true))", "{[Columns = {""Name""}, Primary = true]}"}, {6, "Table.AggregateTableColumn", "Aggregates tables in table[column] into multiple columns containing aggregate values for the tables. aggregations is used to specify the columns containing the tables to aggregate, the aggregation functions to apply to the tables to generate their values, and the names of the aggregate columns to create.", 1, "Table.AggregateTableColumn(#table({""G"", ""T""}, {{""x"", #table({""v""}, {{1}, {2}})}}), ""T"", {{""v"", List.Sum, ""Total""}})", "#table(type table [G = any, Total = any], {{""x"", 3}})"}, {7, "Table.ClearDown", "Replaces the specified columns with null when all their values are repeated from the previous row.", 1, "Table.ClearDown(#table({""G"", ""v""}, {{""a"", 1}, {""a"", 2}, {""b"", 3}}), {""G""})", "#table(type table [G = any, v = any], {{""a"", 1}, {null, 2}, {""b"", 3}})"}, {8, "Table.CombineColumns", "Combines the specified columns into a new column using the specified combiner function.", 1, "Table.CombineColumns(#table({""F"", ""L""}, {{""Ana"", ""Diaz""}}), {""F"", ""L""}, Combiner.CombineTextByDelimiter("" ""), ""Full"")", "#table(type table [Full = text], {{""Ana Diaz""}})"}, {9, "Table.CombineColumnsToRecord", "Combines the specified columns of table into a new record-valued column named newColumnName where each record has field names and values corresponding to the column names and values of the columns that were combined. If a record is specified for options, the following options may be provided: - DisplayNameColumn: When specified as text, indicates that the given column name should be treated as the display name of the record. This need not be one of the columns in the record itself. - TypeName: When specified as text, supplies a logical type name for the resulting record which can be used during data load to drive behavior by the loading environment.", 1, "Table.CombineColumnsToRecord(#table({""a"", ""b""}, {{1, 2}}), ""R"", {""a"", ""b""})", "#table(type table [R = [a = any, b = any]], {{[a = 1, b = 2]}})"}, {10, "Table.ConformToPageReader", "This function is intended for internal use only.", 1, "let#(lf)    T = #table(type table [Name = text, Qty = Int64.Type], {{""a"", 1}, {""b"", 2}, {""a"", 3}})#(lf)in#(lf)    Table.ConformToPageReader(T, each _)", "#table(type table [Name = text, Qty = Int64.Type], {{""a"", 1}, {""b"", 2}, {""a"", 3}})"}, {11, "Table.ExpandListColumn", "Given a table where column contains a list of values, splits the list into a row for each value. Values in the other columns are duplicated in each new row created. This function can also expand nested tables by treating them as lists of records.", 1, "Table.ExpandListColumn(#table({""k"", ""v""}, {{""a"", {1, 2}}, {""b"", {}}}), ""v"")", "#table(type table [k = any, v = any], {{""a"", 1}, {""a"", 2}, {""b"", null}})"}, {12, "Table.ExpandRecordColumn", "Given the column of records in the input table, creates a table with a column for each field in the record. Optionally, newColumnNames may be specified to ensure unique names for the columns in the new table. - table: The original table with the record column to expand. - column: The column to expand. - fieldNames: The list of fields to expand into columns in the table. - newColumnNames: The list of column names to give the new columns. The new column names cannot duplicate any column in the new table.", 1, "Table.ExpandRecordColumn(#table({""r""}, {{[x = 1, y = 2]}}), ""r"", {""x""}, {""r.x""})", "#table(type table [#""r.x"" = any], {{1}})"}, {13, "Table.ExpandTableColumn", "Expands tables in table[column] into multiple rows and columns. columnNames is used to select the columns to expand from the inner table. Specify newColumnNames to avoid conflicts between existing columns and new columns.", 1, "Table.ExpandTableColumn(#table({""k"", ""t""}, {{""a"", #table({""v""}, {{1}, {2}})}}), ""t"", {""v""})", "#table(type table [k = any, v = any], {{""a"", 1}, {""a"", 2}})"}, {14, "Table.FillDown", "Returns a table from the table specified where the value of a previous cell is propagated to the null-valued cells below in the columns specified.", 1, "Table.FillDown(#table({""G"", ""v""}, {{""a"", 1}, {null, 2}, {""b"", 3}}), {""G""})", "#table(type table [G = any, v = any], {{""a"", 1}, {""a"", 2}, {""b"", 3}})"}, {15, "Table.FillUp", "Returns a table from the table specified where the value of the next cell is propagated to the null-valued cells above in the columns specified.", 1, "Table.FillUp(#table({""G"", ""v""}, {{null, 1}, {""a"", 2}}), {""G""})", "#table(type table [G = any, v = any], {{""a"", 1}, {""a"", 2}})"}, {16, "Table.FuzzyGroup", "Groups the rows of table by fuzzily matching values in the specified column, key, for each row. For each group, a record is constructed containing the key columns (and their values) along with any aggregated columns specified by aggregatedColumns. This function cannot guarantee to return a fixed order of rows. An optional set of options may be included to specify how to compare the key columns. Options include: - Culture : Allows grouping records based on culture-specific rules. It can be any valid culture name. For example, a Culture option of ""ja-JP"" groups records based on the Japanese culture. The default value is """", which groups based on the Invariant English culture. - IgnoreCase : A logical (true/false) value that allows case-insensitive key grouping. For example, when true, ""Grapes"" is grouped with ""grapes"". The default value is true. - IgnoreSpace : A logical (true/false) value that allows combining of text parts in order to find groups. For example, when true, ""Gra pes"" is grouped with ""Grapes"". The default value is true. - SimilarityColumnName : A name for the column that shows the similarity between an input value and the representative value for that input. The default value is null, in which case a new column for similarities will not be added. - Threshold : A number between 0.00 and 1.00 that specifies the similarity score at which two values will be grouped. For example, ""Grapes"" and ""Graes"" (missing the ""p"") are grouped together only if this option is set to less than 0.90. A threshold of 1.00 only allows exact matches. (Note that a fuzzy ""exact match"" might ignore differences like casing, word order, and punctuation.) The default value is 0.80. - TransformationTable : A table that allows grouping records based on custom value mappings. It should contain ""From"" and ""To"" columns. For example, ""Grapes"" is grouped with ""Raisins"" if a transformation table is provided with the ""From"" column containing ""Grapes"" and the ""To"" column containing ""Raisins"". Note that the transformation will be applied to all occurrences of the text in the transformation table. With the above transformation table, ""Grapes are sweet"" will also be grouped with ""Raisins are sweet"".", 1, "Table.FuzzyGroup(#table({""City""}, {{""Seattle""}}), ""City"", {{""Count"", each Table.RowCount(_), Int64.Type}})", "error: Expression.Error: We only support text columns for fuzzy join operations. The column 'City' is not of type text."}, {17, "Table.FuzzyGroup", "Groups the rows of table by fuzzily matching values in the specified column, key, for each row. For each group, a record is constructed containing the key columns (and their values) along with any aggregated columns specified by aggregatedColumns. This function cannot guarantee to return a fixed order of rows. An optional set of options may be included to specify how to compare the key columns. Options include: - Culture : Allows grouping records based on culture-specific rules. It can be any valid culture name. For example, a Culture option of ""ja-JP"" groups records based on the Japanese culture. The default value is """", which groups based on the Invariant English culture. - IgnoreCase : A logical (true/false) value that allows case-insensitive key grouping. For example, when true, ""Grapes"" is grouped with ""grapes"". The default value is true. - IgnoreSpace : A logical (true/false) value that allows combining of text parts in order to find groups. For example, when true, ""Gra pes"" is grouped with ""Grapes"". The default value is true. - SimilarityColumnName : A name for the column that shows the similarity between an input value and the representative value for that input. The default value is null, in which case a new column for similarities will not be added. - Threshold : A number between 0.00 and 1.00 that specifies the similarity score at which two values will be grouped. For example, ""Grapes"" and ""Graes"" (missing the ""p"") are grouped together only if this option is set to less than 0.90. A threshold of 1.00 only allows exact matches. (Note that a fuzzy ""exact match"" might ignore differences like casing, word order, and punctuation.) The default value is 0.80. - TransformationTable : A table that allows grouping records based on custom value mappings. It should contain ""From"" and ""To"" columns. For example, ""Grapes"" is grouped with ""Raisins"" if a transformation table is provided with the ""From"" column containing ""Grapes"" and the ""To"" column containing ""Raisins"". Note that the transformation will be applied to all occurrences of the text in the transformation table. With the above transformation table, ""Grapes are sweet"" will also be grouped with ""Raisins are sweet"".", 2, "Table.FuzzyGroup(#table(type table [City = text], {{""Seattle""}, {""seattle""}, {""Redmond""}}), ""City"", {{""Count"", each Table.RowCount(_), Int64.Type}})", "#table(type table [City = text, Count = Int64.Type], {{""Seattle"", 2}, {""Redmond"", 1}})"}, {18, "Table.FuzzyJoin", "Joins the rows of table1 with the rows of table2 based on a fuzzy matching of the values of the key columns selected by key1 (for table1) and key2 (for table2). Fuzzy matching is a comparison based on similarity of text rather than equality of text. By default, an inner join is performed, however an optional joinKind may be included to specify the type of join. Options include: - JoinKind.Inner - JoinKind.LeftOuter - JoinKind.RightOuter - JoinKind.FullOuter - JoinKind.LeftAnti - JoinKind.RightAnti - JoinKind.LeftSemi - JoinKind.RightSemi An optional set of joinOptions may be included to specify how to compare the key columns. Options include: - ConcurrentRequests : A number between 1 and 8 that specifies the number of parallel threads to use for fuzzy matching. The default value is 1. - Culture : Allows matching records based on culture-specific rules. It can be any valid culture name. For example, a Culture option of ""ja-JP"" matches records based on the Japanese culture. The default value is """", which matches based on the Invariant English culture. - IgnoreCase : A logical (true/false) value that allows case-insensitive key matching. For example, when true, ""Grapes"" is matched with ""grapes"". The default value is true. - IgnoreSpace : A logical (true/false) value that allows combining of text parts in order to find matches. For example, when true, ""Gra pes"" is matched with ""Grapes"". The default value is true. - NumberOfMatches : A whole number that specifies the maximum number of matching rows that can be returned for every input row. For example, a value of 1 will return at most one matching row for each input row. If this option is not provided, all matching rows are returned. - SimilarityColumnName : A name for the column that shows the similarity between an input value and the representative value for that input. The default value is null, in which case a new column for similarities will not be added. - Threshold : A number between 0.00 and 1.00 that specifies the similarity score at which two values will be matched. For example, ""Grapes"" and ""Graes"" (missing the ""p"") are matched only if this option is set to less than 0.90. A threshold of 1.00 only allows exact matches. (Note that a fuzzy ""exact match"" might ignore differences like casing, word order, and punctuation.) The default value is 0.80. - TransformationTable : A table that allows matching records based on custom value mappings. It should contain ""From"" and ""To"" columns. For example, ""Grapes"" is matched with ""Raisins"" if a transformation table is provided with the ""From"" column containing ""Grapes"" and the ""To"" column containing ""Raisins"". Note that the transformation will be applied to all occurrences of the text in the transformation table. With the above transformation table, ""Grapes are sweet"" will also be matched with ""Raisins are sweet"".", 1, "Table.FuzzyJoin(#table({""A""}, {{""Seattle""}}), {""A""}, #table({""B""}, {{""seattle""}}), {""B""})", "error: Expression.Error: We only support text columns for fuzzy join operations. The column 'A' is not of type text."}, {19, "Table.FuzzyJoin", "Joins the rows of table1 with the rows of table2 based on a fuzzy matching of the values of the key columns selected by key1 (for table1) and key2 (for table2). Fuzzy matching is a comparison based on similarity of text rather than equality of text. By default, an inner join is performed, however an optional joinKind may be included to specify the type of join. Options include: - JoinKind.Inner - JoinKind.LeftOuter - JoinKind.RightOuter - JoinKind.FullOuter - JoinKind.LeftAnti - JoinKind.RightAnti - JoinKind.LeftSemi - JoinKind.RightSemi An optional set of joinOptions may be included to specify how to compare the key columns. Options include: - ConcurrentRequests : A number between 1 and 8 that specifies the number of parallel threads to use for fuzzy matching. The default value is 1. - Culture : Allows matching records based on culture-specific rules. It can be any valid culture name. For example, a Culture option of ""ja-JP"" matches records based on the Japanese culture. The default value is """", which matches based on the Invariant English culture. - IgnoreCase : A logical (true/false) value that allows case-insensitive key matching. For example, when true, ""Grapes"" is matched with ""grapes"". The default value is true. - IgnoreSpace : A logical (true/false) value that allows combining of text parts in order to find matches. For example, when true, ""Gra pes"" is matched with ""Grapes"". The default value is true. - NumberOfMatches : A whole number that specifies the maximum number of matching rows that can be returned for every input row. For example, a value of 1 will return at most one matching row for each input row. If this option is not provided, all matching rows are returned. - SimilarityColumnName : A name for the column that shows the similarity between an input value and the representative value for that input. The default value is null, in which case a new column for similarities will not be added. - Threshold : A number between 0.00 and 1.00 that specifies the similarity score at which two values will be matched. For example, ""Grapes"" and ""Graes"" (missing the ""p"") are matched only if this option is set to less than 0.90. A threshold of 1.00 only allows exact matches. (Note that a fuzzy ""exact match"" might ignore differences like casing, word order, and punctuation.) The default value is 0.80. - TransformationTable : A table that allows matching records based on custom value mappings. It should contain ""From"" and ""To"" columns. For example, ""Grapes"" is matched with ""Raisins"" if a transformation table is provided with the ""From"" column containing ""Grapes"" and the ""To"" column containing ""Raisins"". Note that the transformation will be applied to all occurrences of the text in the transformation table. With the above transformation table, ""Grapes are sweet"" will also be matched with ""Raisins are sweet"".", 2, "Table.FuzzyJoin(#table(type table [A = text], {{""Seattle""}}), {""A""}, #table(type table [B = text], {{""seattle""}, {""Redmond""}}), {""B""})", "#table(type table [A = text, B = text], {{""Seattle"", ""seattle""}})"}, {20, "Table.FuzzyNestedJoin", "Joins the rows of table1 with the rows of table2 based on a fuzzy matching of the values of the key columns selected by key1 (for table1) and key2 (for table2). The results are returned in a new column named newColumnName. Fuzzy matching is a comparison based on similarity of text rather than equality of text. The optional joinKind specifies the kind of join to perform. By default, a left outer join is performed if a joinKind is not specified. Options include: - JoinKind.Inner - JoinKind.LeftOuter - JoinKind.RightOuter - JoinKind.FullOuter - JoinKind.LeftAnti - JoinKind.RightAnti - JoinKind.LeftSemi - JoinKind.RightSemi An optional set of joinOptions may be included to specify how to compare the key columns. Options include: - ConcurrentRequests : A number between 1 and 8 that specifies the number of parallel threads to use for fuzzy matching. The default value is 1. - Culture : Allows matching records based on culture-specific rules. It can be any valid culture name. For example, a Culture option of ""ja-JP"" matches records based on the Japanese culture. The default value is """", which matches based on the Invariant English culture. - IgnoreCase : A logical (true/false) value that allows case-insensitive key matching. For example, when true, ""Grapes"" is matched with ""grapes"". The default value is true. - IgnoreSpace : A logical (true/false) value that allows combining of text parts in order to find matches. For example, when true, ""Gra pes"" is matched with ""Grapes"". The default value is true. - NumberOfMatches : A whole number that specifies the maximum number of matching rows that can be returned for every input row. For example, a value of 1 will return at most one matching row for each input row. If this option is not provided, all matching rows are returned. - SimilarityColumnName : A name for the column that shows the similarity between an input value and the representative value for that input. The default value is null, in which case a new column for similarities will not be added. - Threshold : A number between 0.00 and 1.00 that specifies the similarity score at which two values will be matched. For example, ""Grapes"" and ""Graes"" (missing the ""p"") are matched only if this option is set to less than 0.90. A threshold of 1.00 only allows exact matches. (Note that a fuzzy ""exact match"" might ignore differences like casing, word order, and punctuation.) The default value is 0.80. - TransformationTable : A table that allows matching records based on custom value mappings. It should contain ""From"" and ""To"" columns. For example, ""Grapes"" is matched with ""Raisins"" if a transformation table is provided with the ""From"" column containing ""Grapes"" and the ""To"" column containing ""Raisins"". Note that the transformation will be applied to all occurrences of the text in the transformation table. With the above transformation table, ""Grapes are sweet"" will also be matched with ""Raisins are sweet"".", 1, "Table.FuzzyNestedJoin(#table({""A""}, {{""Seattle""}}), {""A""}, #table({""B""}, {{""seattle""}}), {""B""}, ""M"")", "#table(type table [A = any, M = nullable table [B = any]], {{""Seattle"", error: Expression.Error: We only support text columns for fuzzy join operations. The column 'B' is not of type text.}})"}, {21, "Table.FuzzyNestedJoin", "Joins the rows of table1 with the rows of table2 based on a fuzzy matching of the values of the key columns selected by key1 (for table1) and key2 (for table2). The results are returned in a new column named newColumnName. Fuzzy matching is a comparison based on similarity of text rather than equality of text. The optional joinKind specifies the kind of join to perform. By default, a left outer join is performed if a joinKind is not specified. Options include: - JoinKind.Inner - JoinKind.LeftOuter - JoinKind.RightOuter - JoinKind.FullOuter - JoinKind.LeftAnti - JoinKind.RightAnti - JoinKind.LeftSemi - JoinKind.RightSemi An optional set of joinOptions may be included to specify how to compare the key columns. Options include: - ConcurrentRequests : A number between 1 and 8 that specifies the number of parallel threads to use for fuzzy matching. The default value is 1. - Culture : Allows matching records based on culture-specific rules. It can be any valid culture name. For example, a Culture option of ""ja-JP"" matches records based on the Japanese culture. The default value is """", which matches based on the Invariant English culture. - IgnoreCase : A logical (true/false) value that allows case-insensitive key matching. For example, when true, ""Grapes"" is matched with ""grapes"". The default value is true. - IgnoreSpace : A logical (true/false) value that allows combining of text parts in order to find matches. For example, when true, ""Gra pes"" is matched with ""Grapes"". The default value is true. - NumberOfMatches : A whole number that specifies the maximum number of matching rows that can be returned for every input row. For example, a value of 1 will return at most one matching row for each input row. If this option is not provided, all matching rows are returned. - SimilarityColumnName : A name for the column that shows the similarity between an input value and the representative value for that input. The default value is null, in which case a new column for similarities will not be added. - Threshold : A number between 0.00 and 1.00 that specifies the similarity score at which two values will be matched. For example, ""Grapes"" and ""Graes"" (missing the ""p"") are matched only if this option is set to less than 0.90. A threshold of 1.00 only allows exact matches. (Note that a fuzzy ""exact match"" might ignore differences like casing, word order, and punctuation.) The default value is 0.80. - TransformationTable : A table that allows matching records based on custom value mappings. It should contain ""From"" and ""To"" columns. For example, ""Grapes"" is matched with ""Raisins"" if a transformation table is provided with the ""From"" column containing ""Grapes"" and the ""To"" column containing ""Raisins"". Note that the transformation will be applied to all occurrences of the text in the transformation table. With the above transformation table, ""Grapes are sweet"" will also be matched with ""Raisins are sweet"".", 2, "Table.FuzzyNestedJoin(#table(type table [A = text], {{""Seattle""}}), {""A""}, #table(type table [B = text], {{""seattle""}, {""Redmond""}}), {""B""}, ""M"")", "#table(type table [A = text, M = nullable table [B = text]], {{""Seattle"", #table(type table [B = any], {{""seattle""}})}})"}, {22, "Table.Group", "Groups the rows of table by the key columns defined by key. The key can either be a single column name, or a list of column names. For each group, a record is constructed containing the key columns (and their values), along with any aggregated columns specified by aggregatedColumns. Optionally, groupKind and comparer may also be specified. If the data is already sorted by the key columns, then a groupKind of GroupKind.Local can be provided. This may improve the performance of grouping in certain cases, since all the rows with a given set of key values are assumed to be contiguous. When passing a comparer, note that if it treats differing keys as equal, a row may be placed in a group whose keys differ from its own. This function does not guarantee the ordering of the rows it returns.", 1, "let#(lf)    T = #table(type table [Name = text, Qty = Int64.Type], {{""a"", 1}, {""b"", 2}, {""a"", 3}})#(lf)in#(lf)    Table.Group(T, {""Name""}, {{""Total"", each List.Sum([Qty]), Int64.Type}})", "#table(type table [Name = text, Total = Int64.Type], {{""a"", 4}, {""b"", 2}})"}, {23, "Table.Join", "Joins the rows of table1 with the rows of table2 based on the equality of the values of the key columns selected by key1 (for table1) and key2 (for table2). By default, an inner join is performed, however an optional joinKind may be included to specify the type of join. Options include: - JoinKind.Inner - JoinKind.LeftOuter - JoinKind.RightOuter - JoinKind.FullOuter - JoinKind.LeftAnti - JoinKind.RightAnti - JoinKind.LeftSemi - JoinKind.RightSemi An optional set of keyEqualityComparers may be included to specify how to compare the key columns. This parameter is currently intended for internal use only.", 1, "Table.Join(#table({""Id"", ""A""}, {{1, ""x""}, {2, ""y""}}), ""Id"", #table({""Key"", ""B""}, {{1, ""p""}}), ""Key"", JoinKind.LeftOuter)", "#table(type table [Id = any, A = any, Key = any, B = any], {{1, ""x"", 1, ""p""}, {2, ""y"", null, null}})"}, {24, "Table.Keys", "Returns the keys of the specified table.", 1, "let#(lf)    T = #table(type table [Name = text, Qty = Int64.Type], {{""a"", 1}, {""b"", 2}, {""a"", 3}})#(lf)in#(lf)    Table.Keys(T)", "{}"}, {25, "Table.NestedJoin", "Joins the rows of table1 with the rows of table2 based on the equality of the values of the key columns selected by key1 (for table1) and key2 (for table2). The results are entered into the column named newColumnName. The optional joinKind specifies the kind of join to perform. By default, a left outer join is performed if a joinKind is not specified. An optional set of keyEqualityComparers may be included to specify how to compare the key columns. This feature is currently intended for internal use only.", 1, "Table.NestedJoin(#table({""Id"", ""A""}, {{1, ""x""}, {2, ""y""}}), ""Id"", #table({""Key"", ""B""}, {{1, ""p""}}), ""Key"", ""Right"", JoinKind.LeftOuter)", "#table(type table [Id = any, A = any, Right = table [Key = any, B = any]], {{1, ""x"", #table(type table [Key = any, B = any], {{1, ""p""}})}, {2, ""y"", #table(type table [Key = any, B = any], {})}})"}, {26, "Table.PartitionKey", "Returns the partition key of the specified table.", 1, "let#(lf)    T = #table(type table [Name = text, Qty = Int64.Type], {{""a"", 1}, {""b"", 2}, {""a"", 3}})#(lf)in#(lf)    Table.PartitionKey(T)", "null"}, {27, "Table.ReplaceErrorValues", "Replaces the error values in the specified columns of the table with the new values in the errorReplacement list. The format of the list is {{column1, value1}, ...}. There may only be one replacement value per column, specifying the column more than once will result in an error.", 1, "Table.ReplaceErrorValues(Table.TransformColumnTypes(#table({""v""}, {{""1""}, {""x""}}), {{""v"", Int64.Type}}), {{""v"", 0}})", "#table(type table [v = nullable number], {{1}, {0}})"}, {28, "Table.ReplaceKeys", "Replaces the keys of the specified table.", 1, "let#(lf)    T = #table(type table [Name = text, Qty = Int64.Type], {{""a"", 1}, {""b"", 2}, {""a"", 3}})#(lf)in#(lf)    Table.Keys(Table.ReplaceKeys(T, {[Columns = {""Name""}, Primary = true]}))", "{[Columns = {""Name""}, Primary = true]}"}, {29, "Table.ReplacePartitionKey", "Replaces the partition key of the specified table.", 1, "let#(lf)    T = #table(type table [Name = text, Qty = Int64.Type], {{""a"", 1}, {""b"", 2}, {""a"", 3}})#(lf)in#(lf)    Table.PartitionKey(Table.ReplacePartitionKey(T, {""Name""}))", "{""Name""}"}, {30, "Table.ReplaceRelationshipIdentity", "This function is intended for internal use only.", 1, "let#(lf)    T = #table(type table [Name = text, Qty = Int64.Type], {{""a"", 1}, {""b"", 2}, {""a"", 3}})#(lf)in#(lf)    Table.ReplaceRelationshipIdentity(T, ""id"")", "#table(type table [Name = text, Qty = Int64.Type], {{""a"", 1}, {""b"", 2}, {""a"", 3}})"}, {31, "Table.ReplaceValue", "Replaces a value with a new value in the specified columns of a table. - table: The table to search. - oldValue: The value to be replaced. - newValue: The replacement value. - replacer: The replacer function to use. The function can be either Replacer.ReplaceText to replace the original text with new text, Replacer.ReplaceValue to replace the original value with a new value, or a custom replacer. - columnsToSearch: A list containing the specific column or columns in the table to search for the value to replace.", 1, "let#(lf)    T = #table(type table [Name = text, Qty = Int64.Type], {{""a"", 1}, {""b"", 2}, {""a"", 3}})#(lf)in#(lf)    {Table.ReplaceValue(T, ""a"", ""A"", Replacer.ReplaceValue, {""Name""}), Table.ReplaceValue(#table({""s""}, {{""banana""}}), ""an"", ""AN"", Replacer.ReplaceText, {""s""})}", "{#table(type table [Name = text, Qty = Int64.Type], {{""A"", 1}, {""b"", 2}, {""A"", 3}}), #table(type table [s = nullable text], {{""bANANa""}})}"}, {32, "Table.Split", "Splits table into a list of tables where the first element of the list is a table containing the first pageSize rows from the source table, the next element of the list is a table containing the next pageSize rows from the source table, and so on.", 1, "let#(lf)    T = #table(type table [Name = text, Qty = Int64.Type], {{""a"", 1}, {""b"", 2}, {""a"", 3}})#(lf)in#(lf)    Table.Split(T, 2)", "{#table(type table [Name = text, Qty = Int64.Type], {{""a"", 1}, {""b"", 2}}), #table(type table [Name = text, Qty = Int64.Type], {{""a"", 3}})}"}, {33, "Table.SplitColumn", "Splits the specified column into a set of additional columns using the specified splitter function. - table: The table containing the column to split. - sourceColumn: The name of the column to split. - splitter: The splitter function used to split the column (for example, Splitter.SplitTextByDelimiter or Splitter.SplitTextByPosition). - columnNamesOrNumber: Either a list of new column names to create, or the number of new columns. - default: Overrides the value used when there aren't enough split values to fill all of the new columns. The default for this parameter is null. - extraColumns: Specifies what to do if there might be more split values than the number of new columns. You can pass an ExtraValues.Type enumeration value to this parameter. The default is ExtraValues.Ignore.", 1, "Table.SplitColumn(#table({""Full""}, {{""Ana Diaz""}}), ""Full"", Splitter.SplitTextByDelimiter("" ""), {""First"", ""Last""})", "#table(type table [First = nullable text, Last = nullable text], {{""Ana"", ""Diaz""}})"}, {34, "Table.TransformColumns", "Transforms the specified table by applying each column operation in a list. - table: The table to transform. - transformOperations: The transformations to make to the table. The format of this parameter is either { column name, transformation } or { column name, transformation, new column type }. - defaultTransformation: (Optional) The default transformation applied to all columns not listed in transformOperations. - missingField: (Optional) Specifies the expected action for missing values. If a column listed in transformOperations doesn't exist, an error is raised (MissingField.Error) unless this parameter specifies an alternative. Use one of the following values: - MissingField.UseNull: Any missing fields are included as null values. - MissingField.Ignore: Any missing fields are ignored.", 1, "let#(lf)    T = #table(type table [Name = text, Qty = Int64.Type], {{""a"", 1}, {""b"", 2}, {""a"", 3}})#(lf)in#(lf)    Value.Type(Table.TransformColumns(T, {{""Name"", Text.Upper}, {""Qty"", each _ * 10, Int64.Type}}))", "type table [Name = nullable text, Qty = Int64.Type]"}, {35, "Table.TransformColumnTypes", "Returns a table by applying the transform operations to the specified columns using an optional culture. - table: The input table to transform. - typeTransformations: The type transformations to apply. The format for a single transformation is { column name, type value }. A list of transformations can be used to change the types of more than one column at a time. If a column doesn't exist, an error is raised. - culture: (Optional) The culture to use when transforming the column types (for example, ""en-US""). If a record is specified for culture, it can contain the following fields: - Culture: The culture to use when transforming the column types (for example, ""en-US""). - MissingField: If a column doesn't exist, an error is raised unless this field provides an alternative behavior (for example, MissingField.UseNull or MissingField.Ignore). The type value in the typeTransformations parameter can be any, all of the number types, text, all of the date, time, datetime, datetimezone, and duration types, logical, or binary. The list, record, table, or function types aren't valid for this parameter. For each column listed in typeTransformations, the "".From"" method corresponding to the specified type value is normally used to perform the transformation. For example, if a Currency.Type type value is given for a column, the transformation function Currency.From is applied to each value in that column.", 1, "{Table.TransformColumnTypes(#table({""d""}, {{""1/2/2024""}}), {{""d"", type date}}, ""en-US""), Table.TransformColumnTypes(#table({""d""}, {{""1/2/2024""}}), {{""d"", type date}}, ""es-ES"")}", "{#table(type table [d = nullable date], {{#date(2024, 1, 2)}}), #table(type table [d = nullable date], {{#date(2024, 2, 1)}})}"}, {36, "Table.TransformRows", "Creates a list by applying the transform operation to each row in table.", 1, "let#(lf)    T = #table(type table [Name = text, Qty = Int64.Type], {{""a"", 1}, {""b"", 2}, {""a"", 3}})#(lf)in#(lf)    Table.TransformRows(T, each [Name] & Text.From([Qty]))", "{""a1"", ""b2"", ""a3""}"}, {37, "Table.Transpose", "Makes columns into rows and rows into columns.", 1, "Table.Transpose(#table({""a"", ""b""}, {{1, 2}, {3, 4}}))", "#table(type table [Column1 = any, Column2 = any], {{1, 3}, {2, 4}})"}}),
				    Joined = Table.NestedJoin(Pages, "seq", Table.TransformColumns(Live, {{"id", Number.From}}), "id", "L", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "L", {"result"}, {"Live"}),
				    Matched = Table.AddColumn(Expanded, "Match", each if [Live] = [Recorded] then "yes" else "NO", type text),
				    Sorted = Table.Sort(Matched, {{"seq", Order.Ascending}})
				in
				    Sorted

	annotation PBI_ResultType = Table
